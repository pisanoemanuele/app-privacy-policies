enum PlaceCategory: String, Codable, CaseIterable {
    case food = "Ristorante"
    case bar = "Bar"
    case cafe = "Caffè"
    case hotel = "Hotel"
    case culture = "Cultura"
    case museum = "Museo"
    case shop = "Shopping"
    case pharmacy = "Farmacia"
    case beach = "Spiaggia"
    case park = "Parco"
    case nightlife = "Locale notturno"
    case transport = "Trasporti"
    case custom = "Personalizzata"

    var icon: String {
        switch self {
        case .food:      return "fork.knife"
        case .bar:       return "wineglass.fill"
        case .cafe:      return "cup.and.saucer.fill"
        case .hotel:     return "bed.double.fill"
        case .culture:   return "building.columns.fill"
        case .museum:    return "building.2.fill"
        case .shop:      return "bag.fill"
        case .pharmacy:  return "cross.fill"
        case .beach:     return "beach.umbrella.fill"
        case .park:      return "leaf.fill"
        case .nightlife: return "music.note.house.fill"
        case .transport: return "tram.fill"
        case .custom:    return "mappin.circle.fill"
        }
    }

    var color: Color {
        switch self {
        case .food:      return .orange
        case .bar:       return .purple
        case .cafe:      return .brown
        case .hotel:     return .blue
        case .culture:   return .indigo
        case .museum:    return .teal
        case .shop:      return .pink
        case .pharmacy:  return .green
        case .beach:     return .cyan
        case .park:      return .mint
        case .nightlife: return .red
        case .transport: return .gray
        case .custom:    return .secondary
        }
    }
}

@Model
class Place {
    var id: UUID = UUID()
    var name: String = ""
    var categoryRaw: String = ""
    var latitude: Double = 0
    var longitude: Double = 0
    var city: String = ""
    var country: String = ""
    var stars: Int = 0
    var note: String = ""
    var dateVisited: Date = Date()
    var phone: String = ""
    var website: String = ""
    var price: Int = 0

    init(
        name: String,
        category: PlaceCategory = .custom,
        latitude: Double,
        longitude: Double,
        city: String = "",
        country: String = "",
        stars: Int = 0,
        note: String = "",
        dateVisited: Date = Date(),
        phone: String = "",
        website: String = "",
        price: Int = 0
    ) {
        self.id = UUID()
        self.name = name
        self.categoryRaw = category.rawValue
        self.latitude = latitude
        self.longitude = longitude
        self.city = city
        self.country = country
        self.stars = stars
        self.note = note
        self.dateVisited = dateVisited
        self.phone = phone
        self.website = website
        self.price = price
    }

    var category: PlaceCategory {
        PlaceCategory(rawValue: categoryRaw) ?? .custom
    }

    var coordinate: CLLocationCoordinate2D {
        CLLocationCoordinate2D(latitude: latitude, longitude: longitude)
    }

    var appleMapsLink: String {
        let encodedName = name.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed) ?? ""
        return "https://maps.apple.com/?q=\(encodedName)&ll=\(latitude),\(longitude)"
    }

    var googleMapsLink: String {
        let encodedName = name.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed) ?? ""
        return "https://www.google.com/maps/search/\(encodedName)/@\(latitude),\(longitude),17z"
    }
}

